# Copie para turn.env somente no servidor. Nunca versione turn.env.
TURN_ENVIRONMENT=staging
TURN_REALM=turn-staging.ecclesiabr.online
TURN_EXTERNAL_IP=134.209.208.169
TURN_LISTENING_PORT=3479
TURN_TLS_LISTENING_PORT=5350
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
TURN_TLS_CERT=/etc/letsencrypt/live/turn-staging.ecclesiabr.online/fullchain.pem
